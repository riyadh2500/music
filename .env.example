# Supabase Config
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin wallet — NEVER expose this on the frontend
# This wallet sends ETH to users when they convert MUSIC tokens
# Fund it with Sepolia ETH at https://sepoliafaucet.com
ADMIN_WALLET_PRIVATE_KEY=your_admin_wallet_private_key_here
